      "parameters": {
        "promptType": "define",
        "text": "=You are Your Name's personal email assistant. Your job is to classify incoming emails and draft replies in the owner's voice when appropriate.\n\nHere is the owner's voice and communication profile:\n{{$('Get a file').item.json.content}}\n\nHere is the incoming email:\nFrom: {{$('Gmail Trigger').item.json.From}}\nSubject: {{$('Gmail Trigger').item.json.Subject}}\nContent: {{$('Gmail Trigger').item.json.snippet}}\nFull Body: {{$('Gmail Trigger').item.json.Text}}\n\nRespond in this exact format with no deviation and no extra commentary:\nDRAFTREPLY: [YES or NO - YES only if this is a real person deserving a personal reply, NO for newsletters, spam, automated, or no-reply emails]\nISLEAD: [YES or NO - YES if this person appears to be a potential client or referral]\nDRAFT:\n[Write the full email reply here in the owner's voice based on his profile above. If DRAFTREPLY is NO write the word NONE here]",
        "options": {}
      },
      "credentials": {}
    },
    {
      "id": "080ff159-860b-4812-9756-ae79bb4cec0f",
      "name": "Send a text message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -32,
        -432
      ],
      "parameters": {
        "chatId": "__replace__",
        "text": "=📧 New Email Draft Ready for Approval!\n\nFrom: {{$('Gmail Trigger').item.json.From}}\nSubject: {{$('Gmail Trigger').item.json.Subject}}\n\n{{$json.output.split('DRAFT:\\n')[1].trim()}}\n\n---\nTo APPROVE and send reply type:\nAPPROVE {{$('Gmail Trigger').item.json.From.split('<')[1].replace('>', '')}}\n\nTo EDIT type:\nEDIT: [your changes] {{$('Gmail Trigger').item.json.From.split('<')[1].replace('>', '')}}",
        "additionalFields": {}
      },
      "credentials": {}
    },
