      "parameters": {
        "jsCode": "const fromField = $('Gmail Trigger').item.json.From;\nconst toEmail = fromField.split('<')[1].replace('>', '').trim();\nconst subject = $('Gmail Trigger').item.json.Subject;\nconst draftOutput = $('AI Agent').item.json.output;\nconst body = draftOutput.split('DRAFT:\\n')[1]?.trim() || draftOutput.trim();\nconst timestamp = new Date().toISOString();\n\nreturn [{ json: {\n  mode: 'store',\n  to: toEmail,\n  subject: `Re: ${subject}`,\n  body: body,\n  timestamp: timestamp\n}}];"
      },
      "credentials": {}
    },
