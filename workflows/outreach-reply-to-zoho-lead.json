        "options": {}
      },
      "credentials": {}
    },
    {
      "id": "48456175-af07-4e5f-98d7-676b141a87cf",
      "name": "Check Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
