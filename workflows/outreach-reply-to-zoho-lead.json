          "conditions": [
            {
              "leftValue": "={{ $json.body.secret }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "__replace__",
              "singleValue": true
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "credentials": {}
    },
    {
      "id": "2cd6b12f-03f1-471e-8e33-ce44ea880fea",
      "name": "Create or Update Lead",
      "type": "n8n-nodes-base.zohoCrm",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "resource": "lead",
        "operation": "upsert",
        "Company": "={{ $json.body.company }}",
        "lastName": "={{ $json.body.last_name }}",
        "additionalFields": {
          "First_Name": "={{ $json.body.first_name }}",
          "Email": "={{ $json.body.email }}",
          "Lead_Source": "Cold Outreach",
          "Description": "={{ $json.body.notes }}"
