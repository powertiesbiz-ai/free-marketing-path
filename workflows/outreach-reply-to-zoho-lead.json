      },
      "credentials": {}
    },
    {
      "id": "d37e41c6-b604-4f46-9fe4-7cb1a6776dd9",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "credentials": {}
    }
