      "name": "Create a contact",
      "type": "n8n-nodes-base.zohoCrm",
      "typeVersion": 1,
      "position": [
        624,
        -48
      ],
      "parameters": {
        "resource": "contact",
        "lastName": "={{$('AI Agent').item.json.output.split('LASTNAME: ')[1].split('\\n')[0].trim()}}",
        "additionalFields": {
          "Email": "={{$('AI Agent').item.json.output.split('EMAIL: ')[1].split('\\n')[0].trim()}}",
          "First_Name": "={{$('AI Agent').item.json.output.split('FIRSTNAME: ')[1].split('\\n')[0].trim()}}",
