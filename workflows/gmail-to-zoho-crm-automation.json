    {
      "id": "f313a74d-dd18-4e68-aaee-65014baf1369",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "position": [
        -48,
        -32
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are a helpful business assistant for Your Business Consulting Group. \nRead this email and extract contact information, then classify it.\n\nEmail From: {{$('Gmail Trigger').item.json.From}}\nEmail Subject: {{$('Gmail Trigger').item.json.Subject}}\nEmail Content: {{$('Gmail Trigger').item.json.snippet}}\n\nRespond ONLY with this exact format, no other text:\nFIRSTNAME: [first name or Unknown]\nLASTNAME: [last name or Unknown]\nEMAIL: [email address]\nPHONE: [phone number or Unknown]\nCOMPANY: [company name or Unknown]\nISLEAD: [YES or NO]\nADDTOCRM: [YES or NO]\nLEADREASON: [one sentence explaining why this is or isn't a lead]\n\nRules:\n- If the email address contains \"noreply\", \"no-reply\", \"donotreply\", or \"mailer\" set ADDTOCRM: NO and ISLEAD: NO\n- If the email is automated, a newsletter, spam, or someone trying to sell you something set ADDTOCRM: NO and ISLEAD: NO\n- A LEAD is a real person who has a direct question, wants advice, or is a potential client or referral — set ISLEAD: YES and ADDTOCRM: YES\n- All other real people — routine correspondence, replies, CCs, forwards, introductions with no question or ask — set ADDTOCRM: NO and ISLEAD: NO. Only someone with a direct question, asking for advice or help, or showing buying/referral intent becomes a lead\n- If you cannot determine the sender's real first AND last name (both would be Unknown), set ADDTOCRM: NO and ISLEAD: NO — never create a CRM record for an unnamed sender. Use the From display name when the email body doesn't include one.\n\n- If you cannot determine a valid EMAIL address for the sender, set ADDTOCRM: NO and ISLEAD: NO — never create a CRM record without an email address. Records without emails cannot be deduped and create duplicates.\n- If the email is a newsletter, bulk/marketing broadcast, digest, roundup, or automated list email — signals include 'unsubscribe' text, 'view in browser', or a public figure/company broadcasting to subscribers — set ADDTOCRM: NO and ISLEAD: NO, even if the sender is a real, well-known person.\n- If the sender is the owner himself (Your Name, or any Your Business.us / Your Business address), set ADDTOCRM: NO and ISLEAD: NO.\n",
        "options": {}
      },
      "credentials": {}
    },
